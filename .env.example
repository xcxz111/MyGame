BOT_TOKEN=
ADMIN_ID=
ADMIN_CHAT=

# MySQL
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=


# ---------------------------------------------------------------------------
# MBanks (пополнение BLIK)
# Запускайте только main.py: при MBANKS_EMBEDDED=1 вебхуки и API mbanks в том же процессе.
# Если видите «Подключение MBanks не настроено» — задайте MBANKS_API_KEY.
# ---------------------------------------------------------------------------
MBANKS_EMBEDDED=
# Встроенный режим: MBANKS_API_URL не нужен (подставится http://127.0.0.1:$WEB_SERVER_PORT).
# Внешний сервис mbanks: MBANKS_EMBEDDED=0 и укажите URL ниже.
# MBANKS_API_URL=https://your-mbanks-host.example
MBANKS_API_KEY=
# Опционально: URL без слэша в конце, с которого mbanks шлёт POST на .../webhooks/mbanks (и .../accounts).
# Встроенный режим (MBANKS_EMBEDDED=1): можно не задавать — подставится http://127.0.0.1:$WEB_SERVER_PORT.
# Нужен явный адрес, если бот за reverse-proxy / другом хосте или внешний mbanks шлёт вебхуки из интернета.
# WEBHOOK_PUBLIC_BASE=https://bot.example.com
WEB_SERVER_HOST=
WEB_SERVER_PORT=
# Опционально: отдельная MySQL-БД для таблиц mbanks_embed (иначе используется MYSQL_DATABASE).
# MBANKS_MYSQL_DATABASE=
# Явный URL БД для mbanks (иначе mysql+aiomysql из MYSQL_*). Пример: sqlite+aiosqlite:///...
# MBANKS_DATABASE_URL=
AI_PROVIDER=
AI_API_KEY=

